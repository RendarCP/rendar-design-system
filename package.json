{
  "name": "rendar-design-system",
  "description": "rendar 디자인 시스템 - Monorepo",
  "homepage": "https://github.com/RendarCP/rendar-design-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RendarCP/rendar-design-system.git"
  },
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "react",
    "typescript",
    "emotion",
    "tailwind",
    "ui",
    "components",
    "storybook",
    "design-system",
    "monorepo"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:core": "turbo run build --filter=@rendar/core",
    "build:emotion": "turbo run build --filter=@rendar/emotion",
    "build:tailwind": "turbo run build --filter=@rendar/tailwind",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook:emotion": "turbo run storybook --filter=@rendar/emotion",
    "storybook:tailwind": "turbo run storybook --filter=@rendar/tailwind",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.10.0",
    "turbo": "^1.11.0",
    "typescript": "^5.2.2",
    "prettier": "^3.1.0",
    "eslint": "^8.53.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "contributors": [
    {
      "name": "Seong Wook Cho",
      "email": "tjddnr0217@gmail.com",
      "url": "https://github.com/RendarCP"
    }
  ],
  "bugs": {
    "url": "https://github.com/RendarCP/rendar-design-system/issues"
  }
}
