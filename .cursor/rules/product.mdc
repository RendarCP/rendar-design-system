## 🎨 디자인 토큰 공유

두 패키지는 동일한 디자인 토큰을 사용해야 합니다.

```typescript
// @rendar/core/src/theme/tokens.ts
export const tokens = {
  colors: {
    primary: {
      50: "#f0f9ff",
      100: "#e0f2fe",
      // ...
      900: "#0c4a6e",
    },
    // ...
  },
  spacing: {
    0: "0",
    1: "0.25rem",
    2: "0.5rem",
    // ...
  },
  borderRadius: {
    none: "0",
    sm: "0.125rem",
    md: "0.375rem",
    lg: "0.5rem",
    // ...
  },
  // ...
};

// @rendar/emotion에서 사용
const theme = {
  palette: {
    primary: {
      main: tokens.colors.primary[500],
      // ...
    },
  },
  spacing: (factor: number) => `${factor * 0.25}rem`,
  // ...
};

// @rendar/tailwind/tailwind.config.js에서 사용
module.exports = {
  theme: {
    extend: {
      colors: tokens.colors,
      spacing: tokens.spacing,
      borderRadius: tokens.borderRadius,
    },
  },
};
```

